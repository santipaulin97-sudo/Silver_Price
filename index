def create_hybrid_chart(df_hist: pd.DataFrame, df_fut: pd.DataFrame, analysis: Dict) -> str:
    try:
        plt.style.use('dark_background')
        fig, ax = plt.subplots(figsize=(12, 7), dpi=150)
        start_plot = datetime.now() - timedelta(days=365)
        df_plot = df_hist[df_hist.index > start_plot]
        
        # COLOR PLATEADO PARA LA PLATA (#BDC3C7)
        ax.plot(df_plot.index, df_plot['Close'], label='Histórico (1 Año)', color='#BDC3C7', linewidth=2)
        
        if not df_fut.empty:
            ax.plot(df_fut.index, df_fut['Proyeccion'], label='Proyección IA', color='#3498DB', linestyle='--')
            fin_precio = analysis['precio_final_proyectado']
            fin_fecha = df_fut.index[-1]
            ax.scatter(fin_fecha, fin_precio, color='#2ECC71', zorder=5, s=100)
            ax.text(fin_fecha, fin_precio, f" Dic 2026: ${fin_precio:,.2f}", color='#2ECC71', ha='right', va='bottom', fontsize=11, fontweight='bold')

        ax.set_title(f"Análisis PLATA: Histórico vs Proyección", fontsize=16, color='white', fontweight='bold')
        ax.set_ylabel("Precio (USD)")
        ax.grid(color='gray', linestyle=':', linewidth=0.3)
        ax.legend(loc='upper left')
        
        filename = "silver_hybrid_chart.png"
        plt.tight_layout()
        plt.savefig(filename)
        plt.close()
        return filename
    except Exception as e: logger.error(f"Error gráfico: {e}"); return None

