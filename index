def obtener_eventos_economicos_eeuu() -> List[Dict]:
    try:
        url = "https://api.finnworlds.com/economic_calendar?country=US&limit=5"
        headers = {"Accept": "application/json"}
        response = requests.get(url, headers=headers, timeout=5)
        if response.status_code == 200:
            data = response.json()
            eventos = []
            for evento in data.get("events", []):
                eventos.append({
                    "fecha": evento.get("date", "N/A"), 
                    "nombre": evento.get("title", "N/A"), 
                    "impacto": evento.get("impact", "N/A")
                })
            return eventos
        return []
    except Exception as e:
        logger.warning(f"API Calendario falló (no crítico): {e}")
        return []

