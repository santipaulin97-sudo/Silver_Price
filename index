# 3. CEREBRO ANALÍTICO
# ---------------------------------------------------------
class FinancialAnalyst:
    def __init__(self, ticker: str):
        self.ticker = ticker
        self.df = pd.DataFrame()

    def get_data(self) -> pd.DataFrame:
        logger.info(f"Descargando datos para {self.ticker}...")
        start_date = datetime.now() - timedelta(days=730) 
        try:
            self.df = yf.download(self.ticker, start=start_date, progress=False, auto_adjust=True)
            if isinstance(self.df.columns, pd.MultiIndex):
                try: self.df = self.df.xs(self.ticker, level=1, axis=1)
                except: self.df.columns = self.df.columns.droplevel(1)
            self.df.fillna(method='ffill', inplace=True)
            return self.df
        except Exception as e:
            logger.error(f"Error crítico datos: {e}")
            return pd.DataFrame()

    def calculate_variations(self) -> List[Dict]:
        variations = []
        if self.df.empty: return variations
        current_price = self.df['Close'].iloc[-1]
        current_date = self.df.index[-1]
        periods = {"1 Semana": 7, "1 Mes": 30, "3 Meses": 90, "6 Meses": 180}
        
        for label, days in periods.items():
            target_date = current_date - timedelta(days=days)
            idx = self.df.index.get_indexer([target_date], method='pad')[0]
            if idx != -1:
                past_price = self.df['Close'].iloc[idx]
                pct = ((current_price - past_price) / past_price) * 100
                variations.append({
                    "periodo": label, "precio_ant": past_price, "variacion": pct,
                    "color": "#27ae60" if pct >= 0 else "#c0392b",
                    "arrow": "▲" if pct >= 0 else "▼"
                })
        return variations

    def perform_regression_analysis(self) -> Tuple[pd.DataFrame, pd.DataFrame, float]:
        df_reg = self.df.dropna().copy()
        df_reg['Ordinal'] = df_reg.index.map(date.toordinal)
        model = LinearRegression().fit(df_reg[['Ordinal']], df_reg['Close'])

        hoy = datetime.now()
        fechas_futuras = pd.date_range(start=hoy, end="2026-12-31", freq='QS-DEC').to_pydatetime()
        dias_futuros = [d.toordinal() for d in fechas_futuras]
        
        ultimo_dia_graf = date(2026, 12, 31).toordinal()
        dias_graf = np.arange(df_reg['Ordinal'].iat[-1] + 1, ultimo_dia_graf + 1)
        
        pred_tabla = model.predict(pd.DataFrame(dias_futuros, columns=['Ordinal'])).flatten()
        pred_graf = model.predict(pd.DataFrame(dias_graf, columns=['Ordinal'])).flatten()

        df_tabla = pd.DataFrame({'Fecha': [f.strftime('%B %Y') for f in fechas_futuras], 'Precio': pred_tabla})
        df_grafico = pd.DataFrame({'Proyeccion': pred_graf}, index=[date.fromordinal(d) for d in dias_graf])
        precio_2026 = pred_tabla[-1] if len(pred_tabla) > 0 else 0.0
        return df_tabla, df_grafico, precio_2026

    def generate_full_analysis(self) -> Dict:
        if self.df.empty or len(self.df) < 200: return {"status": "ERROR"}
        
        # --- CÁLCULO DE MEDIAS MÓVILES (CRÍTICO) ---
        self.df['SMA_50'] = self.df['Close'].rolling(window=50).mean()
        self.df['SMA_200'] = self.df['Close'].rolling(window=200).mean()
        # -------------------------------------------

        precio_actual = self.df['Close'].iloc[-1]
        
        inicio_anio = datetime(datetime.now().year, 1, 1).strftime('%Y-%m-%d')
        df_ytd = self.df.loc[self.df.index >= inicio_anio]
        rendimiento_ytd = ((precio_actual - df_ytd['Close'].iloc[0]) / df_ytd['Close'].iloc[0] * 100) if not df_ytd.empty else 0.0

        delta = self.df['Close'].diff()
        gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
        
        if loss.iloc[-1] == 0:
            rsi = 100
        else:
            rsi = 100 - (100 / (1 + (gain / loss))).iloc[-1]

        variaciones = self.calculate_variations()
        df_tabla, df_graf_fut, precio_2026 = self.perform_regression_analysis()
        
        df_tabla_fmt = df_tabla.copy()
        df_tabla_fmt['Precio'] = df_tabla_fmt['Precio'].apply(lambda x: f"${x:,.2f}")
        tabla_proy_html = df_tabla_fmt.to_html(index=False, justify='center', border=0, classes='projections_table')

        decision, icon, justificacion = "Mantener", "⚖️", "Mercado lateral. Monitorear."
        
        if rsi > 70: 
            decision, icon, justificacion = "Venta / Precaución", "⚠️", "RSI > 70 (Sobrecompra extrema)."
        elif self.df['SMA_50'].iloc[-1] < self.df['SMA_200'].iloc[-1]: 
            decision, icon, justificacion = "Venta", "📉", "Cruce de la muerte técnico confirmado."
        elif len(variaciones) > 3 and variaciones[3]['variacion'] > 10 and precio_2026 > precio_actual:
             decision, icon, justificacion = "Comprar Fuerte", "🚀", f"Tendencia semestral sólida y proyección alcista."

        return {
            "status": "OK", "precio_actual": precio_actual, "rendimiento_ytd": rendimiento_ytd,
            "variaciones": variaciones, "precio_final_proyectado": precio_2026,
            "decision": decision, "justificacion": justificacion, "icon": icon, "rsi": rsi,
            "tabla_proy_html": tabla_proy_html, "df_grafico_futuro": df_graf_fut
        }

