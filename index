def main():
    config = Config()
    analyst = FinancialAnalyst(config.TICKER)
    df = analyst.get_data()
    if df.empty: return

    full_analysis = analyst.generate_full_analysis()
    if full_analysis['status'] == 'ERROR': return
    logger.info(f"Análisis PLATA OK. Precio: ${full_analysis['precio_actual']:.2f}")
    chart_file = create_hybrid_chart(df, full_analysis['df_grafico_futuro'], full_analysis)
    eventos = obtener_eventos_economicos_eeuu()
    mailer = EmailSender(config)
    mailer.send_full_report(full_analysis, eventos, chart_file)
    if chart_file and os.path.exists(chart_file): os.remove(chart_file)

if __name__ == "__main__":
    main()
